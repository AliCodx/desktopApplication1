                    Text = text,
                    TextAlign = topAlign ? ContentAlignment.TopLeft : ContentAlignment.MiddleLeft,
                    Dock = DockStyle.Fill,
                    Margin = new Padding(0, topAlign ? 6 : 0, 0, 0)
