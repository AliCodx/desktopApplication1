using System;
using Microsoft.Data.SqlClient;

namespace StudentManagementSystemProject.Data
{
    // Centralized DB connection helper
    public static class DBConnection
    {
        // Update this connection string to match your SQL Server instance and database
        private static readonly string connectionString = "Server=.;Database=StudentDB;Trusted_Connection=True;";

        public static Microsoft.Data.SqlClient.SqlConnection GetConnection()
        {
            return new Microsoft.Data.SqlClient.SqlConnection(connectionString);
        }
    }
}
